@page "/dashboard"
@model NewProject.UI.Pages.DashboardModel

@{
    ViewData["Title"] = "Products";
    Layout = "_AdminLayout";

    var activeCount =
        Model.Products.Count(p => p.IsActive);

    var inactiveCount =
        Model.Products.Count - activeCount;
}

<div class="admin-shell">



    <!-- SIDEBAR -->
    <aside class="admin-sidebar">

        <a asp-page="/Index"
           class="sidebar-brand">

            Pickaboo <span>Admin</span>

        </a>

        <div class="sidebar-label">
            MANAGEMENT
        </div>

        <a class="sidebar-link active"
           asp-page="/Dashboard">
            Products
        </a>

        <div class="sidebar-bottom">

            <div class="sidebar-user">

                <div class="user-avatar">
                    @(!string.IsNullOrWhiteSpace(Model.FullName)
    ? Model.FullName.Substring(0, 1).ToUpperInvariant()
    : "A")
                </div>

                <div>
                    <strong>@Model.FullName</strong>
                    <small>Administrator</small>
                </div>

            </div>

            <form method="post"
                  asp-page-handler="Logout">

                <button class="logout-button"
                        type="submit">
                    Log out
                </button>

            </form>

        </div>

    </aside>




    <!-- MAIN CONTENT -->
    <main class="admin-main">

        <header class="admin-topbar">

            <div>
                <span class="eyebrow">
                    CATALOG MANAGEMENT
                </span>

                <h1>Products</h1>
            </div>

            <a class="primary-button"
               asp-page="/ProductForm">
                + Add Product
            </a>

        </header>

        <!-- NOTIFICATIONS -->
        @if (TempData["SuccessMessage"] is string success)
        {
            <div class="notice success">
                @success
            </div>
        }

        @if (TempData["ErrorMessage"] is string error)
        {
            <div class="notice error">
                @error
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="notice error">
                @Model.ErrorMessage
            </div>
        }

        <!-- STATISTICS -->
        <section class="stats-grid">

            <article class="stat-card">
                <span>Total products</span>
                <strong>@Model.Products.Count</strong>
            </article>

            <article class="stat-card">
                <span>Active products</span>
                <strong>@activeCount</strong>
            </article>

            <article class="stat-card">
                <span>Inactive products</span>
                <strong>@inactiveCount</strong>
            </article>

        </section>

        <!-- PRODUCT TABLE -->
        <section class="product-panel">

            <div class="panel-heading">

                <div>
                    <h2>All products</h2>

                    <p>
                        Manage your product catalogue and inventory.
                    </p>
                </div>

            </div>

            <!-- SEARCH AND FILTER -->
            <form method="get" class="filter-row">

                <input type="search"
                       name="Search"
                       value="@Model.Search"
                       placeholder="Search by product name" />

                <select name="Status">

                    <option value="">All status</option>

                    <option value="active"
                            selected="@(Model.Status == "active")">
                        Active
                    </option>

                    <option value="inactive"
                            selected="@(Model.Status == "inactive")">
                        Inactive
                    </option>

                </select>

                <button class="secondary-button"
                        type="submit">
                    Filter
                </button>

                <a class="text-link"
                   asp-page="/Dashboard">
                    Clear
                </a>

            </form>




            <!-- TABLE -->
            <div class="table-wrap">

                <table class="product-table">

                    <thead>

                        <tr>
                            <th>PRODUCT</th>
                            <th>PRICE</th>
                            <th>STOCK</th>
                            <th>STATUS</th>
                            <th class="actions-heading">ACTIONS</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Products.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="empty-state">
                                    No products found.
                                    Add your first product to get started.
                                </td>
                            </tr>
                        }

                        @foreach (var product in Model.Products)
                        {
                            <tr>

                                <td>

                                    <div class="product-cell">

                                        @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                        {
                                            <img src="@Model.GetImageUrl(product.ImageUrl)"
                                                 alt="@product.Name" />
                                        }
                                        else
                                        {
                                            <div class="image-placeholder">
                                                No image
                                            </div>
                                        }

                                        <strong>
                                            @product.Name
                                        </strong>

                                    </div>

                                </td>

                                <td>
                                    @product.Price.ToString("N2")
                                </td>

                                <td>@product.StockQuantity</td>

                                <td>

                                    <span class="status-pill @(product.IsActive ? "is-active" : "is-inactive")">

                                        @(product.IsActive ? "Active" : "Inactive")

                                    </span>

                                </td>

                                <td class="actions-cell">
                                    <div class="row-actions">

                                        <a asp-page="/ProductForm"
                                           asp-route-id="@product.Id">
                                            Edit
                                        </a>

                                        <form method="post"
                                              asp-page-handler="Delete"
                                              asp-route-id="@product.Id"
                                              onsubmit="return confirm('Delete this product? This cannot be undone.');">

                                            <button type="submit" class="delete-link">
                                                Delete
                                            </button>

                                        </form>

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </section>

    </main>

</div>
