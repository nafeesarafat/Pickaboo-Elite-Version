@page "/verify-password"
@model NewProject.UI.Pages.VerifyPasswordModel

@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
}

<div class="auth-card">

    <a asp-page="/LoginPage" class="auth-back">
        &#8249;
    </a>

    <div class="auth-heading">

        @if (Model.Step == "email")
        {
            <h1>Forgot Password</h1>
            <p>
                Enter your email address to receive
                a password reset code.
            </p>
        }
        else if (Model.Step == "verify")
        {
            <h1>Verify Code</h1>
            <p>
                Enter the six-digit code sent
                to your email.
            </p>
        }
        else
        {
            <h1>Reset Password</h1>
            <p>
                Create a new password for your account.
            </p>
        }

    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="auth-message auth-error">
            @Model.Message
        </div>
    }

    @if (Model.Step == "email")
    {
        <form method="post"
              asp-page-handler="Send"
              class="auth-form">

            <input asp-for="Email" type="email"
                   class="auth-field"
                   placeholder="Email address"
                   required />

            <button type="submit" class="auth-button">
                Continue
            </button>

        </form>
    }

    else if (Model.Step == "verify")
    {
        <form method="post" asp-page-handler="Verify"
              class="auth-form">

            <input asp-for="Email" type="email"
                   class="auth-field"
                   readonly />

            <input asp-for="Code"
                   class="auth-field"
                   placeholder="Six-digit verification code"
                   inputmode="numeric"
                   pattern="[0-9]{6}"
                   maxlength="6"
                   required />

            <button type="submit" class="auth-button">
                Verify Code
            </button>

        </form>
    }

    else
    {
        <form method="post"
              asp-page-handler="Reset"
              class="auth-form">

            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Code" />

            <div class="auth-password">
                <input asp-for="NewPassword"
                       type="password"
                       id="newPassword"
                       class="auth-field"
                       placeholder="New Password"
                       minlength="8"
                       maxlength="128"
                       required />

                <button type="button"
                        class="auth-toggle"
                        data-target="newPassword">
                    Show
                </button>
            </div>

            <div class="auth-password">
                <input asp-for="ConfirmPassword"
                       type="password"
                       id="confirmNewPassword"
                       class="auth-field"
                       placeholder="Confirm Password"
                       required />

                <button type="button"
                        class="auth-toggle"
                        data-target="confirmNewPassword">
                    Show
                </button>
            </div>

            <button type="submit" class="auth-button">
                Reset Password
            </button>

        </form>
    }

    <div class="auth-footer">
        Remember your password?

        <a asp-page="/LoginPage" class="auth-link">
            Login
        </a>
    </div>

</div>
