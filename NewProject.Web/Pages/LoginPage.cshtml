@page "/login"
@model NewProject.UI.Pages.LoginPageModel

@{
    ViewData["Title"] = "Login";
    Layout = "_AuthLayout";

}

<div class="auth-card">

    <a href="/" class="auth-back" aria-label="Back">
        &#8249;
    </a>

    <div class="auth-heading">
        <h1>Log in</h1>
        <p>
            Enter your email and password to securely
            access your account.
        </p>
    </div>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="auth-message auth-error">
            @Model.Message
        </div>
    }

    @*post request*@
    <form method="post" class="auth-form"> 

        <input asp-for="Email"
               type="email"
               class="auth-field"
               placeholder="Email address"
               autocomplete="email"
               required />

        <div class="auth-password">

            <input asp-for="Password"
                   type="password"
                   id="loginPassword"
                   class="auth-field"
                   placeholder="Password"
                   autocomplete="current-password"
                   required />

            <button type="button"
                    class="auth-toggle"
                    data-target="loginPassword">
                Show
            </button>

        </div>

        <div class="auth-options">

            <label>
                <input type="checkbox" />
                Remember me
            </label>

            <a asp-page="/VerifyPassword">
                Forgot Password?
            </a>

        </div>

        <button type="submit" class="auth-button">
            Login
        </button>

    </form>

    <div class="auth-footer">
        Don't have an account?

        <a asp-page="/RegistrationPage"
           class="auth-link">
            Create Account
        </a>
    </div>

</div>
