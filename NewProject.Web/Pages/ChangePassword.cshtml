@page "/change-password"
@model NewProject.UI.Pages.ChangePasswordModel

@{
    ViewData["Title"] = "Change Password";
    Layout = "_StoreLayout";
}

<div class="shopping-shell account-page">

    <div class="shopping-breadcrumb">
        <a asp-page="/Index">Home</a>
        <span>/</span>
        <a asp-page="/Account">My Account</a>
        <span>/</span>
        <span>Change Password</span>
    </div>

    <div class="account-heading">
        <div>
            <span class="shopping-eyebrow">ACCOUNT SECURITY</span>
            <h1>Change Password</h1>
            <p>Update your account password.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="shopping-notice success-notice">
            @Model.Message
        </div>
    }

    <section class="account-content password-content">

        <div class="account-section-heading">
            <div>
                <h2>Update Your Password</h2>
                <p>Enter your current and new password.</p>
            </div>

            <i data-lucide="lock"></i>
        </div>

        <form method="post" class="account-form">

            <div class="account-field">
                <label asp-for="CurrentPassword">
                    Current Password
                </label>

                <input asp-for="CurrentPassword"
                       type="password"
                       required />
            </div>

            <div class="account-field">
                <label asp-for="NewPassword">
                    New Password
                </label>

                <input asp-for="NewPassword"
                       type="password"
                       minlength="8"
                       maxlength="128"
                       required />
            </div>

            <div class="account-field">
                <label asp-for="ConfirmPassword">
                    Confirm New Password
                </label>

                <input asp-for="ConfirmPassword"
                       type="password"
                       required />
            </div>

            <div class="account-form-actions">

                <a asp-page="/Account"
                   class="secondary-button">
                    Cancel
                </a>

                <button type="submit"
                        class="account-save-button">
                    Change Password
                </button>

            </div>

        </form>

    </section>

</div>
